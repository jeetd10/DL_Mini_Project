# ---------- VIDEO ANALYSIS ----------
elif page == "Video Analysis":
    st.markdown('<div class="section-kicker">02 / PLATFORM</div><div class="section-heading">Video inspection.</div>', unsafe_allow_html=True)
    st.write("Upload a construction-site video for frame-by-frame detection.")
    uploaded_video = st.file_uploader("Upload video", type=["mp4", "mov", "avi"], key="video_upload")

    if uploaded_video is not None:
        st.video(uploaded_video)
        if st.button("Analyze Video", width="stretch"):
            input_path = output_path = None
            cap = writer = None
            try:
                model = load_model()
                with tempfile.NamedTemporaryFile(delete=False, suffix=".mp4") as temp_input:
                    temp_input.write(uploaded_video.getvalue())
                    input_path = temp_input.name
                cap = cv2.VideoCapture(input_path)
                if not cap.isOpened():
                    st.error("Could not open this video.")
                else:
                    fps = cap.get(cv2.CAP_PROP_FPS)
                    fps = fps if fps > 0 else 25.0
                    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
                    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
                    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
                    if width <= 0 or height <= 0:
                        st.error("Invalid video dimensions.")
                    else:
                        with tempfile.NamedTemporaryFile(delete=False, suffix=".mp4") as temp_output:
                            output_path = temp_output.name
                        writer = cv2.VideoWriter(output_path, cv2.VideoWriter_fourcc(*"mp4v"), fps, (width, height))
                        if not writer.isOpened():
                            st.error("Could not create output video.")
                        else:
                            progress = st.progress(0)
                            status = st.empty()
                            class_counts = Counter()
                            frame_count = 0
                            while True:
                                success, frame = cap.read()
                                if not success:
                                    break
                                result = model.predict(frame, conf=confidence, verbose=False)[0]
                                writer.write(result.plot())
                                for box in result.boxes:
                                    class_counts[result.names[int(box.cls[0])]] += 1
                                frame_count += 1
                                if total_frames > 0:
                                    progress.progress(min(frame_count / total_frames, 1.0))
                                if frame_count % 10 == 0:
                                    status.write(f"Processed {frame_count} frames...")
                            writer.release()
                            writer = None
                            cap.release()
                            cap = None
                            if frame_count > 0 and os.path.exists(output_path) and os.path.getsize(output_path) > 0:
                                with open(output_path, "rb") as video_file:
                                    st.session_state["video_result"] = video_file.read()
                                st.session_state["video_classes"] = sorted(class_counts.keys())
                                st.session_state["video_counts"] = dict(class_counts)
                                st.session_state["video_filename"] = uploaded_video.name
                                st.success(f"Analysis complete: {frame_count} frames processed.")
                            else:
                                st.error("No video frames could be processed.")
            except Exception as e:
                st.error(f"Video analysis failed: {e}")
            finally:
                if writer is not None:
                    writer.release()
                if cap is not None:
                    cap.release()
                if input_path and os.path.exists(input_path):
                    os.remove(input_path)
                if output_path and os.path.exists(output_path):
                    os.remove(output_path)

    if "video_result" in st.session_state:
        st.markdown("#### Annotated video")
        st.video(st.session_state["video_result"])
        st.download_button("Download annotated video", data=st.session_state["video_result"], file_name="siteguard_annotated.mp4", mime="video/mp4")
        video_counts = st.session_state.get("video_counts", {})
        if video_counts:
            st.markdown("#### PPE detection indicators across processed frames")
            p1, p2, p3, p4 = st.columns(4)
            p1.metric("Hardhat detections", video_counts.get("Hardhat", 0))
            p2.metric("Safety vest detections", video_counts.get("Safety Vest", 0))
            p3.metric("NO-Hardhat indicators", video_counts.get("NO-Hardhat", 0))
            p4.metric("NO-Safety Vest indicators", video_counts.get("NO-Safety Vest", 0))
            if video_counts.get("NO-Hardhat", 0) or video_counts.get("NO-Safety Vest", 0):
                st.warning("Potential missing-PPE indicators were detected in video frames. Review the footage manually.")
            st.caption("Counts are detections across frames, not unique workers.")



