        stop_camera = st.button(
            "STOP CAMERA",
            width="stretch",
            key="stop_live_camera"
        )

        if stop_camera:
            cap.release()
            st.session_state["live_camera_capture"] = None
            st.session_state["live_camera_active"] = False
            st.rerun()

        # Refresh the page regularly so new frames are processed.
        st_autorefresh(interval=200, key="live_camera_refresh")

        ok, frame = cap.read()
        if ok and frame is not None:
            try:
                model = load_model()
                result = model.predict(
                    frame,
                    conf=confidence,
                    verbose=False
                )[0]

                annotated = result.plot()
                annotated_rgb = cv2.cvtColor(
                    annotated, cv2.COLOR_BGR2RGB
                )

                st.markdown("#### Live detection feed")
                st.image(annotated_rgb, width="stretch")

                frame_counts = Counter(
                    result.names[int(box.cls[0])]
                    for box in result.boxes
                )
                total_detections = sum(frame_counts.values())

                m1, m2 = st.columns(2)
                m1.metric("Objects in current frame", total_detections)
                m2.metric("Classes in current frame", len(frame_counts))

                normalized = {
                    " ".join(name.lower().replace("_", " ").split()): count
                    for name, count in frame_counts.items()
                }

                missing_items = {
                    name: count for name, count in frame_counts.items()
                    if any(term in name.lower().replace("_", " ")
                           for term in ("no-hardhat", "no hardhat",
                                        "no-safety vest", "no safety vest",
                                        "no-mask", "no mask"))
                }

                if missing_items:
                    st.warning(
                        "Potential missing-PPE indicators: "
                        + ", ".join(
                            f"{name} ({count})"
                            for name, count in missing_items.items()
                        )
                    )
                else:
                    st.success(
                        "No missing-PPE classes detected in this frame. "
                        "This does not prove all workers are compliant."
                    )

                if frame_counts:
                    st.markdown("#### Current-frame detections")
                    st.dataframe(
                        [
                            {"Class": name, "Detections": count}
                            for name, count in frame_counts.items()
                        ],
                        hide_index=True,
                        width="stretch"
                    )
                else:
                    st.caption(
                        "No objects detected in this frame. "
                        "Try adjusting the confidence threshold."
                    )

                st.caption(
                    "Counts describe this frame, not unique workers. "
                    "AI predictions require human review."
                )

            except Exception as exc:
                st.error(f"Live detection failed: {exc}")
        else:
            st.warning(
                "No frame received. The stream may have disconnected. "
                "Check the camera app or reconnect."
            )

    else:
        st.markdown(
            '<div class="panel"><h3>Camera not connected</h3>'
            '<p>Start your phone camera stream, enter its URL, '
            'and select CONNECT CAMERA.</p></div>',
            unsafe_allow_html=True
        )
