# ---------- MODEL AND SESSION DATA ----------
@st.cache_resource
def load_model():
    """Load the trained model from the project-relative weights path."""
    model_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "models", "best.pt")
    if not os.path.isfile(model_path):
        raise FileNotFoundError(
            "Model weights were not found at models/best.pt. Add your trained best.pt file "
            "to a models/ folder beside app.py before starting SiteGuard AI."
        )
    return YOLO(model_path)


